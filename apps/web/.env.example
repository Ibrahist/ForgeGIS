# ========================================================
# ForgeGIS Environment Configuration
# ========================================================

# CARTO Basemaps API Key
# Required by CARTO to remove the "API KEY REQUIRED" watermark on Carto Dark Matter and Positron tiles.
# Get a free API key at: https://carto.com/basemaps/apikey/ (No account required)
VITE_CARTO_API_KEY=

# Mapbox Access Token (Optional)
# Used for custom Mapbox styles and vector/raster tile services.
# Get your token at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=
